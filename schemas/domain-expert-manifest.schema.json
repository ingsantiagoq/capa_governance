{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UBP Domain Expert Manifest v9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "id",
    "domain",
    "scope",
    "coveredCapabilities",
    "seedNodes",
    "escalationTriggers",
    "prohibitedActions",
    "handoffTargets",
    "retrieval",
    "knowledgeSources",
    "semanticAnchors",
    "policies"
  ],
  "properties": {
    "kind": {
      "const": "domain-expert"
    },
    "version": {
      "const": 9
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "coveredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "seedNodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "escalationTriggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk",
          "targets"
        ],
        "properties": {
          "risk": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "prohibitedActions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absolute",
        "withoutApproval"
      ],
      "properties": {
        "absolute": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "withoutApproval": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "handoffTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "seedNodes",
        "maxExpansions",
        "sourcePolicy",
        "provenance"
      ],
      "properties": {
        "order": {
          "const": [
            "manifest",
            "graphify",
            "source"
          ]
        },
        "seedNodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "maxExpansions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "sourcePolicy": {
          "const": "only-after-manifest-and-graph"
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "knowledgeSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ubp",
        "market"
      ],
      "properties": {
        "ubp": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "reference",
              "purpose"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "market": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vendor",
              "reference",
              "purpose",
              "sourcePolicy"
            ],
            "properties": {
              "vendor": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sourcePolicy": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              }
            }
          }
        }
      }
    },
    "semanticAnchors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "ubpMeaning",
          "marketLens",
          "decisionRule"
        ],
        "properties": {
          "term": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "ubpMeaning": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "marketLens": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "decisionRule": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reference",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
