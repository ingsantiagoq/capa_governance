{
  "services": [
    "inventory-service",
    "ubp-bff",
    "pos-service",
    "ar-service",
    "ap-service",
    "production-service",
    "edge-node"
  ],
  "contracts": [
    "inventory.proto: InventoryService",
    "GetAvailability",
    "ReserveStock",
    "EmitMovement",
    "AdjustIn",
    "AdjustOut",
    "AdjustValue",
    "ImportItems"
  ],
  "dependencies": [
    "tenant context",
    "branch scope",
    "item catalog",
    "warehouse/bin/lot/serial tracking",
    "ledger posting for valued adjustments",
    "POS and AR sales issue inventory movements",
    "AP purchase receipt movements",
    "edge stock mirror"
  ],
  "restrictions": [
    "no negative stock unless explicitly modeled",
    "idempotency required for emitted movements",
    "branch ownership must be validated server-side",
    "tracked items require explicit/default location resolution",
    "BFF remains the user-facing boundary"
  ],
  "governance": {
    "deterministic": [
      "read item catalog",
      "read stock availability",
      "validate branch scope",
      "emit normal sale/purchase movement through existing services"
    ],
    "poDecision": [
      "commercial behavior when stock is missing",
      "whether substitutions or backorders are allowed",
      "manual adjustment policy",
      "visibility of stock by role"
    ],
    "architectHandoff": [
      "changes touching POS/AR/AP/inventory together",
      "edge synchronization or offline behavior",
      "new inventory costing semantics",
      "new cross-service event flow"
    ],
    "reviewerGate": [
      "tenant isolation",
      "stock idempotency",
      "branch scope",
      "ledger consistency",
      "walkthrough POS impact"
    ],
    "forbiddenWithoutApproval": [
      "real stock adjustments",
      "production deploy",
      "schema migrations",
      "changing costing policy"
    ]
  },
  "retrieval": {
    "order": [
      "manifest",
      "graphify",
      "source"
    ],
    "seedNodes": [
      "ADR-0021 Inventario y Sucursales",
      "inventory.proto InventoryService",
      "InventoryGrpcService",
      "StockService",
      "ReservationService",
      "InventoryAdjustmentsExcelEndpoints",
      "V1PosEndpoints inventory calls",
      "edge StockMirror"
    ],
    "maxExpansions": 1,
    "sourcePolicy": "only-after-manifest-and-graph",
    "provenance": "Example transcribed from UBP context-pack trials on 2026-09-07. Seed labels require resolution against the consumer's pinned Graphify index; this is not a live production catalog."
  },
  "capability": {
    "id": "inventory",
    "name": "Inventario",
    "intents": [
      "consultar disponibilidad por sucursal",
      "reservar inventario",
      "ajustar inventario"
    ]
  }
}
